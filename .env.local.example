# FMS Dental — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Supabase (Required) ────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - used server-side only for admin operations
# Never expose this in the browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Optional: AI Assistant (Phase 5) ───────────────────────
# Uncomment to enable Gemini-powered AI chat assistant
# GEMINI_API_KEY=your-gemini-api-key

# ─── Optional: Telegram Notifications ───────────────────────
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ─── Setup Instructions ──────────────────────────────────────
# 1. Create a free Supabase project at https://supabase.com
# 2. Run the SQL in supabase/schema.sql in your Supabase SQL Editor
# 3. Go to Settings → API and copy your URL and anon key
# 4. To create an admin user:
#    - Go to Authentication → Users → Invite User
#    - Then run in SQL Editor:
#      INSERT INTO profiles (id, role) VALUES ('your-user-uuid', 'admin');
# 5. Copy this file to .env.local and fill in the values
# 6. Run: npm run dev
